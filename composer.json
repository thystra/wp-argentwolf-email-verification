{
  "name": "thystra/argentwolf-email-verification",
  "description": "Local email verification and account activation for WordPress users.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6.16",
    "yoast/phpunit-polyfills": "^3.1"
  },
  "config": {
    "optimize-autoloader": true,
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "lint:php": "php tests/lint-php.php",
    "test:dependency-free": "php tests/run.php",
    "test:integration": "phpunit --configuration phpunit.integration.xml.dist",
    "test": [
      "@lint:php",
      "@test:dependency-free"
    ]
  }
}
